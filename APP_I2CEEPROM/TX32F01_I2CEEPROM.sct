; APP_I2CEEPROM scatter
;
; Standalone APP, owns the reset vector at 0x01000000. No BL.
;
;   Flash 32 KB total:
;     0x01000000 .. 0x010017FF   code + RO data        (6 KB)
;     0x01001800 .. 0x010057FF   host-visible EEPROM   (16 KB)
;     0x01005800 .. 0x01007FFF   reserved              (10 KB)
;
;   SRAM 4 KB:
;     0x20000000 .. 0x20000FFF   RW/ZI + stack

LR_I2CEE 0x01000000 0x00001800  {
  ER_CODE 0x01000000 0x00001800  {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_RAM 0x20000000 0x00001000  {
    .ANY (+RW +ZI)
  }
}
